{
  "name": "Nettoyeur DXF Station",
  "short_name": "DXF Station",
  "description": "Nettoie les DXF des bureaux d'études pour la station d'implantation : purge, calques, mise en mètres, recalage, export R12 léger.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef0ec",
  "theme_color": "#e8590c",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/dxf": [
          ".dxf"
        ],
        "image/vnd.dxf": [
          ".dxf"
        ],
        "image/x-dxf": [
          ".dxf"
        ]
      },
      "icons": [
        {
          "src": "dxf-file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "dxf-file-64.png",
          "sizes": "64x64",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
